# Everything docker compose needs. Copy it, then start:
#     cp .env.example .env
#     docker compose up -d
# .env is gitignored. These demo values work as they are - change the passwords
# before the lab is reachable by anyone but you.

# --- Postgres ---------------------------------------------------------------------
# The database the generator writes and the API reads. Not published to the LAN.
POSTGRES_USER=antifraud
POSTGRES_DB=antifraud
POSTGRES_PASSWORD=demo-postgres-password-change-me

# --- Live generator ---------------------------------------------------------------
# Real seconds per simulated hour: 12 = one simulated day every ~5 minutes.
REAL_SECONDS_PER_SIM_HOUR=12
# 1: after a start or a long break, generate the missed time flat out until the
# simulated clock reaches now. 0: carry on from where it stopped, at normal pace.
CATCH_UP=1
