# Everything docker compose needs. Copy it, then start:
#     cp .env.example .env
#     docker compose up -d
# .env is gitignored. These demo values work as they are - change the passwords
# before the lab is reachable by anyone but you.

# --- Postgres ---------------------------------------------------------------------
# The database the generator writes and the API reads. Not published to the LAN.
POSTGRES_USER=antifraud
POSTGRES_DB=antifraud
POSTGRES_PASSWORD=demo-postgres-password-change-me

# --- Live generator ---------------------------------------------------------------
# It never runs ahead of the real clock: once caught up, each simulated hour is
# written as soon as that hour has ended in the real world. These two only decide
# how it catches up after a first start or a long break.
# 1: generate the missed time flat out (from 2026-09-01: about 10 minutes).
# 0: one simulated hour every REAL_SECONDS_PER_SIM_HOUR seconds until caught up.
CATCH_UP=1
REAL_SECONDS_PER_SIM_HOUR=12

# --- API ------------------------------------------------------------------------
API_PORT=8000
# Full-access keys (read + create risk checks), comma-separated, sent in X-API-Key.
# Postman's apiKey is one of these.
API_KEYS=demo-full-key-change-me
# Extra read-only keys, comma-separated - Postman's readApiKey, for example. Optional:
# the panel's key below is added to the read keys by itself.
API_READ_KEYS=demo-read-key-change-me

# --- Admin panel ----------------------------------------------------------------
PANEL_PORT=5000
# The key the panel calls the API with. Always read-only.
PANEL_API_KEY=demo-panel-key-change-me
# Signs the login cookie. Any long random string; changing it logs everyone out.
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=demo-secret-key-change-me-to-a-long-random-string
# Who may log in, "name:hash", comma-separated. The demo user is
#     admin / demo-admin-password-change-me
# A new line:  docker compose exec admin flask --app app hash-password <name>
# SINGLE QUOTES: the hash is full of $, and compose would read $... as variables.
ADMIN_USERS='admin:scrypt:32768:8:1$UcNF3lOE80OkqI75$534b5855c9b5dfdce466e2fba8f736bcfceb886a37bee6de49ac315071eadbf0a7ca9f1bbc19569d42ded20e453b2cb09458b92f19d4a1f2983eb6c8e44f88ee'
# How long a login lasts, in hours.
SESSION_HOURS=8
# 1 once the panel is behind HTTPS. 0 on plain http, or the login will not stick.
SECURE_COOKIES=0
