    {
      "id": 4,
      "type": "stat",
      "title": "Paid out (${currency})",
      "description": "Winnings paid on bets settled in the time range.",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT coalesce(sum(s.payout), 0) AS v FROM settlements s JOIN bets b ON b.id = s.bet_id WHERE b.currency = '${currency}' AND $__timeFilter(s.settled_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
