{
  "uid": "antifraud-money",
  "title": "Money",
  "description": "Deposits, withdrawals, turnover and margin, one currency at a time. Simulated time, from Postgres.",
  "tags": [
    "antifraud-lab"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "timezone": "utc",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "currency",
        "label": "Currency",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "postgres"
        },
        "query": "SELECT DISTINCT currency FROM players ORDER BY 1",
        "definition": "SELECT DISTINCT currency FROM players ORDER BY 1",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {
          "text": "EUR",
          "value": "EUR"
        },
        "description": "Amounts in different currencies cannot be added up, so one at a time."
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Antifraud Lab",
      "type": "dashboards",
      "tags": [
        "antifraud-lab"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Deposited (${currency})",
      "description": "Approved deposits, by when they were processed.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT coalesce(sum(amount), 0) AS v FROM transactions WHERE direction = 'deposit' AND status = 'approved' AND currency = '${currency}' AND $__timeFilter(processed_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
