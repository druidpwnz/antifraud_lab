{
  "uid": "antifraud-scoring",
  "title": "Scoring",
  "description": "Precision and recall of each detection rule against the planted fraud.",
  "tags": [
    "antifraud-lab"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "timezone": "utc",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Antifraud Lab",
      "type": "dashboards",
      "tags": [
        "antifraud-lab"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "About this dashboard",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "datasource": null,
      "targets": [],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "How good is each rule? Its alerts against `fraud_labels` - the ground truth the generator writes for every fraud it plants. The rules never read that table; this dashboard may, because a dashboard is not a detection rule. Not affected by the time range: the scores cover every row each rule has checked. Source: the `rule_scores` view (`db/migrations/007_rule_scores.sql`)."
      }
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Precision - how many alerts were real",
      "description": "caught / detected. 1.0 = no false alarms.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT rule_code, precision FROM rule_scores ORDER BY rule_code",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SETTLEMENT_MISMATCH"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "LATE_BET"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "STAKE_ANOMALY"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Recall - how much planted fraud was found",
      "description": "caught / planted. SETTLEMENT_MISMATCH is low on purpose until it learns about losing bets that were paid (phase 9 step 8).",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
