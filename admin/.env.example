# Copy to admin/.env (gitignored). `flask run` reads it automatically.

# Where the API is, and the key the panel uses. Give the panel a READ-ONLY key - one
# from the API's API_READ_KEYS - so a leaked panel key cannot create anything.
API_URL=http://127.0.0.1:8000
API_KEY=dev-read-key-change-me

# Signs the session cookie. Any long random string; changing it logs everyone out.
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Seconds to wait for the API before showing "API unavailable".
API_TIMEOUT=5

# Who may log in: "name:hash", comma-separated. Make an entry with
#     flask --app app hash-password igor
# and paste the line it prints here. Empty means nobody can log in.
ADMIN_USERS=

# How long a login lasts, in hours.
SESSION_HOURS=8

# 1 once the panel is served over HTTPS: the session cookie is then never sent over
# plain http. Leave 0 for local development, or login will not stick.
SECURE_COOKIES=0
