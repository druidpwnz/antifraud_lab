# Copy to api/.env (gitignored), then start with:
#     uvicorn app.main:app --reload --env-file .env
# Nothing reads .env on its own - settings.py only sees real environment variables,
# and --env-file is what puts these into the environment.

# libpq connection string. Same database the generator writes to.
DATABASE_URL=dbname=antifraud

# Comma-separated API keys, sent in the X-API-Key header.
# API_KEYS have full access: every read, and creating risk checks.
API_KEYS=dev-key-change-me
# API_READ_KEYS can only read - give the admin panel one of these. Optional.
API_READ_KEYS=dev-read-key-change-me

# Connection pool size. Each concurrent request holds one connection while it runs.
POOL_MIN=1
POOL_MAX=10

# Prometheus metrics on their own port (compose: 9100, not published). Unset or 0
# locally: off, so two services on one machine do not fight over the port.
METRICS_PORT=0
