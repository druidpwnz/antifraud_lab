meta {
  name: List players - next page
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/players?limit=5&cursor={{nextCursor}}
  body: none
  auth: none
}

params:query {
  limit: 5
  cursor: {{nextCursor}}
}

docs {
  Run "List players - first page" before this one: it saves nextCursor.
}

tests {
  test("page 2 carries on exactly where page 1 stopped", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items[0].id).to.be.greaterThan(bru.getVar("lastIdOnPage1"));
  });
}
