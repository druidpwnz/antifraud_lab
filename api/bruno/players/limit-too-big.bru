meta {
  name: Limit too big - 422
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v1/players?limit=500
  body: none
  auth: none
}

params:query {
  limit: 500
}

tests {
  test("422 says which field and why, and does not echo the input", function () {
    expect(res.status).to.equal(422);
    const error = res.body.errors[0];
    expect(error.loc).to.eql(["query", "limit"]);
    expect(error.type).to.equal("less_than_equal");
    expect(error).to.not.have.property("input");
  });
}
