meta {
  name: List players - filtered
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/players?country=UA&status=active&limit=20
  body: none
  auth: none
}

params:query {
  country: UA
  status: active
  limit: 20
}

tests {
  test("every player matches both filters", function () {
    expect(res.status).to.equal(200);
    res.body.items.forEach((p) => {
      expect(p.country).to.equal("UA");
      expect(p.status).to.equal("active");
    });
  });
}
