meta {
  name: Player not found - 404
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/players/999999999
  body: none
  auth: none
}

tests {
  test("404 as problem+json", function () {
    expect(res.status).to.equal(404);
    expect(res.headers["content-type"]).to.equal("application/problem+json");
    expect(res.body.detail).to.equal("Player 999999999 does not exist.");
    expect(res.body.instance).to.equal("/v1/players/999999999");
  });
}
