meta {
  name: Wrong API key - 401
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/v1/players/1
  body: none
  auth: none
}

headers {
  X-API-Key: definitely-not-a-real-key
}

tests {
  test("401 with a WWW-Authenticate header", function () {
    expect(res.status).to.equal(401);
    expect(res.headers["www-authenticate"]).to.equal('ApiKey header="X-API-Key"');
  });
}
